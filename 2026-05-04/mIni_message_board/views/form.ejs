
<!DOCTYPE html>
<html>
<head>
  <title>New Message</title>
</head>
<body>

<h1>Add a New Message</h1>

<form method="POST" action="/new">
  
  <label>Name:</label>
  <input type="text" name="user" required>
  <br><br>

  <label>Message:</label>
